# Copy this file to .env and fill in values, or set these as real
# environment variables / Windows service environment settings.

# Shared passcode every device must enter once. Leave blank to disable
# access control (fine for a private VPN/LAN, NOT recommended if the
# server is reachable from the open internet).
ACCESS_CODE=change-me-please

# Where the SQLite database file lives. Defaults to ./babytracker.db
# next to app.py if not set.
DB_PATH=C:\babytracker\babytracker.db
