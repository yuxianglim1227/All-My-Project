{
  "name": "Social Studio",
  "short_name": "Studio",
  "id": "/studio/",
  "start_url": "/studio/#library",
  "scope": "/studio/",
  "display": "standalone",
  "background_color": "#f6f6fb",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/studio/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/studio/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/studio/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["image/*", "video/*"] }] }
  }
}
