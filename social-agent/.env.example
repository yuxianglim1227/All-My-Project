# ---------------------------------------------------------------------------
# Easiest: run `python -m socialagent setup` (checks your keys, finds your Telegram id, writes .env for you).
# Or copy this file to .env and fill it in by hand. NEVER commit .env (it is git-ignored).
# Everything defaults to SAFE: DRY_RUN=true means nothing is ever posted.
# ---------------------------------------------------------------------------

# --- Safety -----------------------------------------------------------------
DRY_RUN=true                 # set to false only after `socialagent selfcheck` passes
UNDO_WINDOW_SECONDS=120      # "post now" waits this long so you can cancel
TIMEZONE=UTC                 # IANA name, e.g. Europe/London. Posting windows use this.

# --- Claude (the creative brain) ---------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5 # looks at your photos/videos (vision). Cheaper option: claude-sonnet-5-5
WRITER_MODEL=                # writes/rewrites captions (text only); empty = same as CLAUDE_MODEL. e.g. claude-sonnet-5-5
CLAUDE_EFFORT=medium         # low | medium | high
CLAUDE_FALLBACKS=true        # server-side refusal fallback

# --- Inbound: Telegram (send media to a private bot) ---------------------------
TELEGRAM_BOT_TOKEN=          # from @BotFather
OWNER_TELEGRAM_ID=           # only this user may control the agent (bot tells you your id on first /start)
TELEGRAM_API_BASE=           # optional: local Bot API server, e.g. http://localhost:8081 (lifts the 20 MB download cap)

# --- Inbound: HTTP (iOS/Android Shortcut, no size limit) + public media URLs ----
HTTP_HOST=0.0.0.0           # behind Caddy / a tunnel on the same machine, use 127.0.0.1 so only the proxy can reach it
HTTP_PORT=8080
API_TOKEN=                   # long random string; required to use POST /api/submit
PUBLIC_BASE_URL=https://agent.example.com   # must be public HTTPS: Instagram downloads media from here

# --- Instagram (official Graph API, "Instagram API with Instagram Login") -----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_BASE=https://graph.instagram.com
IG_API_VERSION=              # e.g. v23.0 - leave empty to use Meta's default; check Meta's changelog

# --- TikTok (official Content Posting API) --------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MODE=direct           # direct = post via API | inbox = upload as draft, you tap Publish in TikTok
TIKTOK_PRIVACY=SELF_ONLY     # unaudited apps can ONLY post private; switch to PUBLIC_TO_EVERYONE after TikTok's audit

# --- Editing -------------------------------------------------------------------
EDIT_LEVEL=enhance            # none = your originals | enhance = light/colour polish (default) | fit = + reframe to 9:16 | creative = + hook text
FFMPEG_BIN=                  # full path if ffmpeg is not on the service account's PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_BIN=                 # optional; defaults to ffprobe next to FFMPEG_BIN
MAX_REEL_SECONDS=90
FONT_PATH=                   # optional TTF/OTF for on-screen text (auto-detected if empty)
JIANYING_DRAFTS_DIR=         # optional: your CapCut/Jianying drafts folder (desktop only, experimental)

# --- Paths ---------------------------------------------------------------------
DATA_DIR=./data
BRAND_FILE=./config/brand.yaml
COLLECT_WINDOW_SECONDS=3     # wait this long for the rest of an album / a follow-up text before drafting
